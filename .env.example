# ==============================================================================
# Public Environment Variables Template (.env.example)
# Copy this file to .env and fill in your actual private credentials.
# ==============================================================================

# Application Metadata
VITE_APP_TITLE="QSkill Slab 1 Suite"
VITE_APP_VERSION="1.0.0"

# RapidAPI Credentials (Private)
# Get a free API key at: https://rapidapi.com/googlecloud/api/google-translate1
VITE_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_RAPIDAPI_HOST=google-translate1.p.rapidapi.com

# Defaults & Preferences
VITE_DEFAULT_SOURCE_LANG=en
VITE_DEFAULT_TARGET_LANG=es
VITE_ENABLE_SOUND=true
